{
  "name": "madox",
  "version": "0.0.1",
  "private": true,
  "description": "Madox desktop and web app",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npx vite",
    "dev:desktop": "cross-env VITE_DESKTOP=true npx vite",
    "dev:server": "tsx server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npx vite build",
    "build:desktop": "cross-env VITE_DESKTOP=true npx vite build",
    "build:server": "tsup server/index.ts --format esm --target node20 --out-dir dist-server --clean",
    "package:desktop": "npm run build:desktop && npx electron-builder --win",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@hono/node-server": "^1.19.11",
    "@sentry/node": "^10.45.0",
    "@sentry/react": "^10.45.0",
    "@upstash/qstash": "^2.10.1",
    "@upstash/redis": "^1.37.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^11.5.4",
    "hono": "^4.12.9",
    "lucide-react": "0.522.0",
    "meilisearch": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.29.1"
  },
  "build": {
    "appId": "com.bobim.madox",
    "productName": "Madox",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
